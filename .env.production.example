# Sunucu için .env şablonu. En kolayı: bash scripts/init-env.sh <alan-adı> <yönetici-e-postası>
# Betik bu dosyayı .env olarak kopyalar ve şifreleri rastgele üretir. Elle doldurmak için:
# cp .env.production.example .env, sonra boş değerleri doldurun. .env git'e eklenmez.

# docker-compose.yml ile production eki birlikte kullanılır: HTTPS (Caddy), kapalı portlar, log sınırı.
# Bu satır sayesinde "docker compose ..." komutlarına ayrıca -f vermek gerekmez.
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# Sitenin alan adı. DNS kaydı (A) bu sunucunun IP'sini göstermeli; Caddy sertifikayı bu ad için alır.
DOMAIN=yazilimgelistirme.ktun.edu.tr

# SQL Server "sa" şifresi: en az 8 karakter; büyük harf, küçük harf, rakam ve sembolden en az üçü. Noktalı virgül (;) olmasın.
MSSQL_SA_PASSWORD=

# JWT imzalama anahtarı: en az 64 karakter, rastgele. Üretmek için: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET_KEY=

# İlk yönetici: sadece ilk kurulumda bu bilgilerle oluşturulur. Sonra şifre ve yeni yöneticiler panelden yönetilir.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Şifre unutulursa true yapıp "docker compose up -d" çalıştırın; girişten sonra mutlaka false'a geri alın.
ADMIN_RESET_PASSWORD=false

# Sunucuda kapalı kalmalı: açık olursa ilk kurulumda örnek ekip, etkinlik, başvuru ve sertifikalar eklenir.
SEED_SAMPLE_CONTENT=false

# SQL Server 2025 bu sunucuda açılmazsa (eski Linux çekirdeği, ör. CentOS 7) baştaki # işaretini kaldırıp
# "docker compose up -d" çalıştırın. Veritabanı henüz boşken yapılmalı: 2025'te oluşmuş veri 2022'ye taşınamaz.
#MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2022-latest
