{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.DataProtection": "Error",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "MigrateOnStartup": true
  },
  "Seed": {
    "SampleContent": false,
    "Admin": {
      "Name": "Admin",
      "Email": "admin@ygt.com"
    }
  },
  "Jwt": {
    "Issuer": "Ygt",
    "Audience": "YgtAdmin",
    "SecretKey": "",
    "ExpiresInHours": 4
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "ApplicationsPerMinute": 60,
    "LoginPerMinute": 5
  },
  "Storage": {
    "RootPath": "storage"
  }
}
