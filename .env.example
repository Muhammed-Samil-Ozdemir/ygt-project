# Bu dosyayı .env adıyla kopyalayın. .env git'e eklenmez.
# Değerler yerel geliştirme içindir; sunucuda hepsini mutlaka değiştirin.

# SQL Server "sa" şifresi: en az 8 karakter; büyük harf, küçük harf, rakam ve sembolden en az üçü.
# Bağlantı cümlesini bozacağı için noktalı virgül (;) kullanmayın.
MSSQL_SA_PASSWORD=Ygt_Dev_2026!

# Bilgisayardan erişilecek port. 1433 doluysa değiştirin (appsettings.Development.json'daki port da değişmeli).
MSSQL_PORT=1433

# JWT imzalama anahtarı: en az 64 karakter, rastgele. Sunucuda üretmek için: openssl rand -base64 64
JWT_SECRET_KEY=yerel-gelistirme-anahtari-sadece-bilgisayarda-kullanin-sunucuda-mutlaka-degistirin-0123456789

# İlk yönetici: ilk kurulumda (hiç yönetici yokken) bu bilgilerle oluşturulur. Sonra şifre ve yeni yöneticiler
# panelden yönetilir; buradaki şifreyi değiştirmek mevcut yöneticiyi etkilemez.
ADMIN_EMAIL=admin@ygt.com
ADMIN_PASSWORD=Admin_Dev_2026!

# Şifre unutulursa true yapıp "docker compose up -d" çalıştırın: ADMIN_EMAIL yöneticisinin şifresi ADMIN_PASSWORD olur.
# Giriş yaptıktan sonra mutlaka false'a geri alın; açık kalırsa panelden değiştirilen şifre her açılışta geri döner.
ADMIN_RESET_PASSWORD=false

# Sitenin açılacağı port. 80 doluysa başka bir port verin (ör. 8090 -> http://localhost:8090).
WEB_PORT=80
