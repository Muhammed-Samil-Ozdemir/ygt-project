{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": false,
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": ["default"],
    "sharedGlobals": []
  },
  "targetDefaults": {
    "@angular/build:application": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    }
  },
  "generators": {
    "@nx/angular:component": {
      "style": "none",
      "changeDetection": "OnPush",
      "viewEncapsulation": "None",
      "skipTests": true,
      "skipSelector": true,
      "exportDefault": true
    }
  }
}
